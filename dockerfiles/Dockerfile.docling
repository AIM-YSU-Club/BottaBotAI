FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# docling_cache 볼륨(/root/.cache)에 가려지지 않도록 HF 캐시 분리
ENV HF_HOME=/opt/huggingface
ENV TRANSFORMERS_CACHE=/opt/huggingface
ENV HUGGINGFACE_HUB_CACHE=/opt/huggingface

# 기본은 CUDA 12.4. Mac/CPU 빌드: --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# transformers(sentence-transformers)는 PyTorch >= 2.5 를 요구한다.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
ARG TORCH_VERSION=2.6.0
ARG TORCHVISION_VERSION=0.21.0

COPY requirements/base.txt requirements/docling.txt requirements/

# docling이 PyPI CPU torch를 끌어올 수 있어, CUDA/지정 휠은 마지막에 덮어쓴다.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements/docling.txt \
    && pip install --no-cache-dir --force-reinstall \
        torch==${TORCH_VERSION} torchvision==${TORCHVISION_VERSION} \
        --index-url ${TORCH_INDEX_URL}

COPY bottabot/ bottabot/

ENV PYTHONPATH=/app

CMD ["celery", "-A", "bottabot.celery.app", "worker", "-Q", "docling_queue", "--loglevel=info", "-c", "1"]
