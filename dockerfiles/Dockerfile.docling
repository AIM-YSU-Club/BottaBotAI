FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# docling_cache 볼륨(/root/.cache)에 가려지지 않도록 HF 캐시 분리
ENV HF_HOME=/opt/huggingface
ENV TRANSFORMERS_CACHE=/opt/huggingface
ENV HUGGINGFACE_HUB_CACHE=/opt/huggingface

COPY requirements/base.txt requirements/docling.txt requirements/torch.txt requirements/

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements/docling.txt

COPY bottabot/ bottabot/

ENV PYTHONPATH=/app

CMD ["celery", "-A", "bottabot.celery.app", "worker", "-Q", "docling_queue", "--loglevel=info", "-c", "1"]
